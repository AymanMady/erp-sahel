{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP Sahel",
  "version": "../package.json",
  "identifier": "mr.sahel.erp",
  "build": {
    "frontendDist": "./dist",
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ERP Sahel",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "ERP Sahel",
    "longDescription": "Sales management, inventory, point of sale and accounting — works offline.",
    "createUpdaterArtifacts": false,
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMTJEMTZFRkQwRkNGM0IKUldRN3p3LzlidEVTV3l1VUlWOGx5RWp3ZDYzMGFmQ1NpMVhaRGFPdHJ1aVV4SndYQ1lvZVNIeGwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
