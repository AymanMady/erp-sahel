# --- Base de données -------------------------------------------------------
# PostgreSQL 14+. `docker compose up -d db` démarre une instance locale conforme.
DATABASE_URL=postgresql://erp:erp@localhost:5436/erp_sahel

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=5000
# Origine publique, utilisée pour les liens de documents et la configuration CORS.
APP_URL=http://localhost:5000

# --- Sécurité --------------------------------------------------------------
# OBLIGATOIRE en production : chaîne aléatoire d'au moins 32 caractères.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées à appeler l'API (séparées par des virgules).
# La coquille Tauri appelle l'API depuis tauri.localhost : gardez-la en production desktop.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,tauri://localhost,http://tauri.localhost

# --- Données de démonstration ---------------------------------------------
# `npm run db:seed` crée la société de démonstration et ce compte administrateur.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_COMPANY_NAME=Sahel Commerce
SEED_COMPANY_SUBDOMAIN=sahel
