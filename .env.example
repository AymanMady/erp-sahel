# --- Database ---------------------------------------------------------------
# PostgreSQL 14+. `docker compose up -d db` starts a suitable local instance.
DATABASE_URL=postgresql://erp:erp@localhost:5436/erp_sahel

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public origin, used for document links and CORS configuration.
APP_URL=http://localhost:5000

# --- Security ---------------------------------------------------------------
# REQUIRED in production: random string of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origins allowed to call the API (comma-separated).
# The Tauri shell calls the API from tauri.localhost: keep it for desktop production.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,tauri://localhost,http://tauri.localhost

# --- Demo data --------------------------------------------------------------
# `npm run db:seed` creates the demo company and this administrator account.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_COMPANY_NAME=Sahel Commerce
SEED_COMPANY_SUBDOMAIN=sahel

# --- Desktop shell (Tauri) -------------------------------------------------
# Optional server pre-filled in the desktop app, for an installer made for one single
# customer. Leave it empty: one installer then serves everybody, and the server
# address is asked at first launch. Read from `.env.desktop` by `npm run build:desktop`.
DESKTOP_API_URL=

# Where this server finds the desktop release to offer its workstations: the
# `latest.json` published by the release workflow. Empty: no update is offered.
# Set it once this server itself runs the same release, never before.
# DESKTOP_UPDATE_MANIFEST_URL=https://github.com/<owner>/<repo>/releases/latest/download/latest.json

# Oldest desktop release allowed to send data (e.g. 1.2.0). Older workstations keep
# their sales locally and are asked to update. Can only raise the floor set in code
# (`shared/app-version.ts`).
# DESKTOP_MIN_VERSION=

# --- Platform super-administrator -------------------------------------------
# A single hidden account, created (or repaired) at every server start: it alone sees
# the technical screens (data sending, database backup and restore). It belongs to no
# company and is never listed in the users screen. Its password can only be changed
# here. REQUIRED in production: at least 12 characters, with letters and digits.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperAdmin123!
