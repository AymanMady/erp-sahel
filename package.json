{
  "name": "erp-sahel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ERP Sahel — ERP générique, simple et hors ligne, pour tout type de commerce (modules activables : caisse, achats, stock…).",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run check && npm run lint && npm run test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:desktop": "vite build --mode desktop",
    "tauri": "tauri",
    "tauri:dev": "npm run build:desktop && tauri dev",
    "tauri:build": "npm run build:desktop && tauri build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-query": "^5.64.1",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "compression": "^1.7.5",
    "date-fns": "4.4.0",
    "dexie": "^4.0.11",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "1.24.0",
    "next-themes": "0.4.6",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "radix-ui": "1.6.2",
    "react": "19.2.4",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "recharts": "3.9.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "wouter": "^3.7.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.12",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
